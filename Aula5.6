#include <stdio.h>

int main() {
    int numero;
    int i;

    for (i = 1; i <= 5; i++) {
        printf("Digite o %d numero: ", i);
        scanf("%d", &numero);

        printf("Antecessor: %d\n", numero - 1);
        printf("Numero: %d\n", numero);
        printf("Sucessor: %d\n\n", numero + 1);
    }

    return 0;
}
