#include <stdio.h>

int main() {
    float altura;
    float soma = 0;
    float media;
    int i;

    for (i = 1; i <= 5; i++) {
        printf("Digite a altura da pessoa %d: ", i);
        scanf("%f", &altura);

        soma = soma + altura;
    }

    media = soma / 5;

    printf("A media das alturas e: %.2f metros\n", media);

    return 0;
}
