#include <stdio.h>

int main() {
    float nota1, nota2, media;
    int i;

    for (i = 1; i <= 10; i++) {
        printf("\nAluno %d\n", i);

        printf("Digite a primeira nota: ");
        scanf("%f", &nota1);

        printf("Digite a segunda nota: ");
        scanf("%f", &nota2);

        media = (nota1 + nota2) / 2;

        printf("Media do aluno: %.2f\n", media);
    }

    return 0;
}
