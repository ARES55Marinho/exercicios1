#include <stdio.h>

int main() {
    int numero;
    int quantidadePares = 0;
    int i;

    for (i = 1; i <= 30; i++) {
        printf("Digite o %d numero: ", i);
        scanf("%d", &numero);

        if (numero % 2 == 0) {
            quantidadePares++;
        }
    }

    printf("\nQuantidade de numeros pares: %d\n", quantidadePares);

    return 0;
}
